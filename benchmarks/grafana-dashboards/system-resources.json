{
  "id": null,
  "title": "System Resource Utilization",
  "tags": ["system", "resources", "node-exporter", "performance"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "5s",
  "description": "Comprehensive system resource metrics including CPU, memory, network, and disk I/O utilization collected by Node Exporter",
  "panels": [
    {
      "id": 1,
      "type": "graph",
      "title": "CPU Usage by Mode",
      "description": "CPU utilization broken down by usage mode (user, system, idle, etc.)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "Total CPU Usage %"
        }
      ],
      "yaxes": [
        {"format": "percent", "label": "CPU Usage (%)", "min": 0, "max": 100},
        {"format": "short"}
      ],
      "tooltip": {
        "shared": true,
        "sort": 2,
        "value_type": "individual"
      }
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Memory Usage Overview",
      "description": "System memory utilization showing used vs available memory",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used Memory"
        },
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available Memory"
        }
      ],
      "yaxes": [
        {"format": "bytes", "label": "Memory"},
        {"format": "short"}
      ]
    },
    {
      "id": 3,
      "type": "graph",
      "title": "Network I/O by Device",
      "description": "Network throughput showing bytes received and transmitted per device",
      "gridPos": {"x": 0, "y": 9, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "irate(node_network_receive_bytes_total[5m])",
          "legendFormat": "Received - {{device}}"
        },
        {
          "expr": "irate(node_network_transmit_bytes_total[5m])",
          "legendFormat": "Transmitted - {{device}}"
        }
      ],
      "yaxes": [
        {"format": "Bps", "label": "Bytes per second"},
        {"format": "short"}
      ]
    },
    {
      "id": 4,
      "type": "graph",
      "title": "Disk I/O by Device",
      "description": "Disk read/write throughput per device",
      "gridPos": {"x": 12, "y": 9, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "irate(node_disk_read_bytes_total[5m])",
          "legendFormat": "Read - {{device}}"
        },
        {
          "expr": "irate(node_disk_written_bytes_total[5m])",
          "legendFormat": "Written - {{device}}"
        }
      ],
      "yaxes": [
        {"format": "Bps", "label": "Bytes per second"},
        {"format": "short"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU Core Count",
      "description": "Total number of CPU cores detected by the system",
      "gridPos": {"x": 0, "y": 18, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "count(count(node_cpu_seconds_total) by (cpu))",
          "legendFormat": "CPU Cores"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total System Memory",
      "description": "Total installed system memory",
      "gridPos": {"x": 6, "y": 18, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "Total Memory"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Root Disk Usage",
      "description": "Percentage of root filesystem disk space used",
      "gridPos": {"x": 12, "y": 18, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{mountpoint=\"/\"})",
          "legendFormat": "Disk Usage %"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "System Load Average (5m)",
      "description": "5-minute system load average",
      "gridPos": {"x": 18, "y": 18, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "node_load5",
          "legendFormat": "Load 5m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    }
  ]
}
