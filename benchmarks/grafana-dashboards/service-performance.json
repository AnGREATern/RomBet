{
  "id": null,
  "title": "Service Performance Metrics",
  "tags": ["rombet", "performance", "http", "latency"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "5s",
  "description": "Comprehensive performance metrics for the RomBet service including HTTP latency, request rates, error rates, and resource utilization",
  "panels": [
    {
      "id": 1,
      "type": "graph",
      "title": "HTTP Request Latency Distribution",
      "description": "Shows latency percentiles for HTTP requests over time",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "50th Percentile (Median)"
        },
        {
          "expr": "histogram_quantile(0.75, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "75th Percentile"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "90th Percentile"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "95th Percentile"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "99th Percentile"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Latency (seconds)"},
        {"format": "short"}
      ],
      "tooltip": {
        "shared": true,
        "sort": 2,
        "value_type": "individual"
      }
    },
    {
      "id": 2,
      "type": "graph",
      "title": "HTTP Requests Per Second by Method",
      "description": "Request rate breakdown by HTTP method",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (method)",
          "legendFormat": "{{method}} requests"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Requests per second"},
        {"format": "short"}
      ]
    },
    {
      "id": 3,
      "type": "graph",
      "title": "HTTP Error Rates by Status Code",
      "description": "Error rate breakdown by HTTP status code categories",
      "gridPos": {"x": 0, "y": 9, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{code=~\"5.*\"}[5m]))",
          "legendFormat": "5xx Server Errors"
        },
        {
          "expr": "sum(rate(http_requests_total{code=~\"4.*\"}[5m]))",
          "legendFormat": "4xx Client Errors"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Errors per second"},
        {"format": "short"}
      ]
    },
    {
      "id": 4,
      "type": "graph",
      "title": "Process Memory Usage",
      "description": "Memory consumption of the RomBet service process",
      "gridPos": {"x": 12, "y": 9, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "Resident Memory"
        }
      ],
      "yaxes": [
        {"format": "bytes", "label": "Memory Usage"},
        {"format": "short"}
      ]
    },
    {
      "id": 5,
      "type": "graph",
      "title": "CPU Usage",
      "description": "CPU consumption of the RomBet service process",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 9},
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])",
          "legendFormat": "CPU Seconds per Second"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "CPU Utilization"},
        {"format": "short"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total HTTP Requests",
      "description": "Cumulative count of all HTTP requests processed",
      "gridPos": {"x": 12, "y": 18, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(http_requests_total)",
          "legendFormat": "Total Requests"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Current Error Rate",
      "description": "Percentage of requests resulting in 4xx or 5xx errors",
      "gridPos": {"x": 18, "y": 18, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{code=~\"[45].*\"}[5m])) / sum(rate(http_requests_total[5m])) * 100",
          "legendFormat": "Error Rate %"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    }
  ]
}
